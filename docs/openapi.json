    "/api/models/run": {
      "post": {
        "tags": [
          "Models"
        ],
        "summary": "Queue anomaly model run",
        "responses": {
          "202": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required or token invalid"
          },
          "403": {
            "description": "Role not permitted"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "if",
                      "eif",
                      "dif"
                    ]
                  },
                  "top_k": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000,
                    "default": 50
                  },
                  "n_estimators": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 1000,
                    "default": 200
                  },
                  "random_state": {
                    "type": "integer",
                    "default": 42
                  },
                  "include_umap": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    },
