{
  "info": {
    "name": "P.A.T.H. API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Compatibility health check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Liveness check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health/live"
      }
    },
    {
      "name": "Readiness check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health/ready"
      }
    },
    {
      "name": "Authenticate a user",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{email}}"
            },
            {
              "key": "password",
              "value": "{{password}}"
            }
          ]
        }
      }
    },
    {
      "name": "Rotate a refresh token and issue a new access token",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/refresh",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Revoke the current refresh token",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/logout"
      }
    },
    {
      "name": "Return the validated authenticated session",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "Change Password",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/change-password",
        "body": {
          "mode": "raw",
          "raw": "{\"current_password\": \"{{current_password}}\", \"new_password\": \"{{new_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users"
      }
    },
    {
      "name": "Create a user",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{new_user_email}}\",\n  \"password\": \"{{new_password}}\",\n  \"role\": \"analyst\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Update a user role or active state",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/api/users/{{user_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/users/{{user_id}}/reset-password",
        "body": {
          "mode": "raw",
          "raw": "{\"new_password\": \"{{new_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Validate and activate a CSV dataset",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/datasets/upload",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "List datasets",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/datasets"
      }
    },
    {
      "name": "Delete an inactive dataset",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/datasets/{{dataset_id}}"
      }
    },
    {
      "name": "List active-dataset transactions with cursor pagination",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/transactions"
      }
    },
    {
      "name": "Get a transaction and its current anomaly/review context",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/transactions/{{transaction_id}}"
      }
    },
    {
      "name": "Queue one anomaly model run",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/models/run",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"if\",\n  \"top_k\": 50,\n  \"n_estimators\": 200,\n  \"random_state\": 42,\n  \"include_umap\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Get model-job progress",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/models/jobs/{{job_id}}"
      }
    },
    {
      "name": "List Top-K anomalies for the active model run",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/anomalies"
      }
    },
    {
      "name": "Executive analytics summary",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/analytics/summary"
      }
    },
    {
      "name": "Flagged-count trend for current and previous model runs",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/analytics/trend"
      }
    },
    {
      "name": "Break down active anomalies by dimension",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/analytics/breakdown"
      }
    },
    {
      "name": "List reviews for the active run",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/reviews"
      }
    },
    {
      "name": "Record a human validation decision",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/reviews/{{transaction_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Pending Review\",\n  \"note\": \"Review note\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Read immutable audit events",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/audit"
      }
    }
  ]
}
